{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@zonesim/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "../core/src"],
  "exclude": ["../core/src/globals.d.ts"]
}
