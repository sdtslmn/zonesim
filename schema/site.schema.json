    "hmi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "device": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "timeout": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "polling": {
      "type": "array",
      "description": "Traffic the plant generates by itself. Replaces the inherited list.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "service",
          "every"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "service": {
            "enum": [
              "ssh",
              "http",
              "https",
              "modbus",
              "rdp"
            ]
          },
          "fc": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            }
          },
          "every": {
            "type": "number",
            "minimum": 1
          },
          "when": {
            "enum": [
              "normal",
              "takeover"
            ],
            "description": "Only in normal operation, or only while the backup centre has taken over. Leave out for always."
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Data flows the plant needs. Give from/to/service for one hop, or paths for alternatives.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "remove": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "service": {
            "enum": [
              "ssh",
              "http",
              "https",
              "modbus",
              "rdp"
            ]
          },
          "fc": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "service"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,23}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,23}$"
                  },
                  "service": {
                    "enum": [
                      "ssh",
                      "http",
                      "https",
                      "modbus",
                      "rdp"
                    ]
                  },
                  "fc": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 127
                    }
                  }
                }
              }
            }
          },
          "when": {
            "enum": [
              "normal",
              "takeover"
            ],
            "description": "Only in normal operation, or only while the backup centre has taken over. Leave out for always."
          }
        }
      }
    },
    "standby": {
      "type": "object",
      "description": "A main control centre with a passive backup. The backup sends nothing to the plant until the main centre is lost (takeover start); then the hosts in lost stop and the backup takes over the HMI role and the polls and flows marked when: takeover.",
      "required": [
        "backup",
        "lost"
      ],
      "additionalProperties": false,
      "properties": {
        "centre": {
          "type": "string",
          "description": "What the main centre is called, for example OCC"
        },
        "backupName": {
          "type": "string",
          "description": "What the backup centre is called, for example BOCC"
        },
        "backup": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "lost": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "description": "Hosts that stop when the main centre is lost. Must include the HMI host."
        }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,23}$"
            }
          },
          "description": "Hosts that normally write to each controller"
        },
        "safety": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "description": "Controllers where any write is critical"
        },
        "identify": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "description": "Hosts allowed to read device identification"
        }
      }
    }
  }
}
