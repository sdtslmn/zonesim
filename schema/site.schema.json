{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdtslmn.github.io/zonesim/schema/site.schema.json",
  "title": "ZoneSim site file",
  "description": "A plant for the ZoneSim OT/ICS security simulator. See docs/help/customize.md.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zonesim-site/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "description": "Short id, lower-case letters, digits and dashes"
    },
    "name": {
      "type": "string",
      "description": "Shown in the simulator"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "string",
      "description": "A built-in site to start from, e.g. riverside-water. Anything you leave out comes from it."
    },
    "rename": {
      "type": "object",
      "description": "Rename hosts or zones of the site being extended. Every reference is updated.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,23}$"
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "enum": [
            "water-tank",
            "gas-compressor",
            "dc-cooling",
            "metro-line"
          ],
          "description": "The process the plant runs"
        },
        "tags": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "default": "upstream line"
            },
            "consumer": {
              "type": "string",
              "default": "downstream line"
            },
            "tank": {
              "type": "string",
              "default": "T-101"
            },
            "pump": {
              "type": "string",
              "default": "CHWP-1"
            },
            "dosing": {
              "type": "string",
              "default": "P-201"
            },
            "compressor": {
              "type": "string",
              "default": "K-101"
            },
            "recycle": {
              "type": "string",
              "default": "UV-101"
            },
            "esd": {
              "type": "string",
              "default": "SDV-102"
            },
            "relief": {
              "type": "string",
              "default": "PSV-103"
            },
            "meter": {
              "type": "string",
              "default": "FQ-104"
            },
            "hall": {
              "type": "string",
              "default": "Data hall 1"
            },
            "chiller1": {
              "type": "string",
              "default": "CH-1"
            },
            "chiller2": {
              "type": "string",
              "default": "CH-2"
            },
            "crah": {
              "type": "string",
              "default": "CRAH units"
            },
            "agent": {
              "type": "string",
              "default": "clean agent"
            },
            "line": {
              "type": "string",
              "default": "Meridian Line"
            },
            "substation": {
              "type": "string",
              "default": "TPSS-1"
            },
            "rectifier": {
              "type": "string",
              "default": "RECT-1"
            },
            "feeder": {
              "type": "string",
              "default": "CB-11"
            },
            "fan1": {
              "type": "string",
              "default": "TVF-1"
            },
            "fan2": {
              "type": "string",
              "default": "TVF-2"
            },
            "tunnel": {
              "type": "string",
              "default": "Central to Quay tunnel"
            }
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Display names, e.g. tank: T-101"
        },
        "params": {
          "type": "object",
          "properties": {
            "initialLevel": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 55,
              "description": "Tank level at start, %"
            },
            "inflow": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20,
              "default": 1.2,
              "description": "Level rise per second while the inlet pump runs, %"
            },
            "demand": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 35,
              "description": "Gas the downstream customers take, % of design flow"
            },
            "startLevel": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 40,
              "description": "Default pump start level in auto mode, %"
            },
            "stopLevel": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 80,
              "description": "Default pump stop level in auto mode, %"
            },
            "lowAlarm": {
              "type": "number",
              "minimum": 0,
              "maximum": 300,
              "default": 50,
              "description": "Downstream pressure low alarm, bar"
            },
            "highAlarm": {
              "type": "number",
              "minimum": 0,
              "maximum": 300,
              "default": 70,
              "description": "Discharge pressure high alarm, bar"
            },
            "highHighAlarm": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 95,
              "description": "High-high level alarm, %"
            },
            "tripLevel": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 95,
              "description": "Default safety trip level, %"
            },
            "tripReset": {
              "type": "number",
              "minimum": 0,
              "maximum": 300,
              "default": 68,
              "description": "The safety trip resets below this pressure, bar"
            },
            "chlorineSetpoint": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 1.5,
              "description": "Default chlorine setpoint, mg/L"
            },
            "chlorineInitial": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 1.5,
              "description": "Chlorine residual at start, mg/L"
            },
            "chlorineLow": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 0.5,
              "description": "Low chlorine alarm, mg/L"
            },
            "chlorineHigh": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "default": 4,
              "description": "High chlorine alarm, mg/L"
            },
            "chlorineTau": {
              "type": "number",
              "minimum": 1,
              "maximum": 3600,
              "default": 15,
              "description": "Seconds for the residual to follow the setpoint"
            },
            "chlorineDecay": {
              "type": "number",
              "minimum": 1,
              "maximum": 3600,
              "default": 40,
              "description": "Seconds for the residual to decay with dosing off"
            },
            "suctionPressure": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "default": 40,
              "description": "Upstream (suction) pressure, bar"
            },
            "headMax": {
              "type": "number",
              "minimum": 5,
              "maximum": 300,
              "default": 70,
              "description": "Pressure the compressor adds at full speed and no flow, bar"
            },
            "setpoint": {
              "type": "number",
              "minimum": 1,
              "maximum": 300,
              "default": 65,
              "description": "Default discharge pressure setpoint, bar"
            },
            "designFlow": {
              "type": "number",
              "minimum": 1,
              "maximum": 100000,
              "default": 400,
              "description": "Design flow, thousand standard m³ per hour"
            },
            "tripPressure": {
              "type": "number",
              "minimum": 0,
              "maximum": 300,
              "default": 75,
              "description": "Default safety trip pressure (PSHH), bar"
            },
            "reliefPressure": {
              "type": "number",
              "minimum": 0,
              "maximum": 300,
              "default": 80,
              "description": "Relief valve set pressure, bar"
            },
            "surgeLine": {
              "type": "number",
              "minimum": 1,
              "maximum": 99,
              "default": 55,
              "description": "Minimum flow through the compressor, % of what its speed can push"
            },
            "surgeMargin": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 15,
              "description": "Margin the anti-surge controller keeps above the surge line, %"
            },
            "pressureRate": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20,
              "default": 0.5,
              "description": "Pressure change per second at a 100 % flow imbalance, bar"
            },
            "speedRate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 100,
              "default": 2,
              "description": "How fast the speed can change, % per second"
            },
            "vibrationTrip": {
              "type": "number",
              "minimum": 1,
              "maximum": 600,
              "default": 10,
              "description": "Seconds of surge before the compressor trips on vibration"
            },
            "itLoad": {
              "type": "number",
              "minimum": 1,
              "maximum": 100000,
              "default": 1200,
              "description": "IT load of the hall, kW"
            },
            "chillerCapacity": {
              "type": "number",
              "minimum": 1,
              "maximum": 100000,
              "default": 1500,
              "description": "Cooling capacity of each chiller, kW"
            },
            "chwSetpoint": {
              "type": "number",
              "minimum": 4,
              "maximum": 30,
              "default": 14,
              "description": "Default chilled water supply setpoint, °C"
            },
            "supplyAirSetpoint": {
              "type": "number",
              "minimum": 10,
              "maximum": 35,
              "default": 24,
              "description": "Default CRAH supply air (cold aisle) setpoint, °C"
            },
            "approach": {
              "type": "number",
              "minimum": 1,
              "maximum": 20,
              "default": 8,
              "description": "How much warmer the cold aisle is than the chilled water at best, K"
            },
            "recommendedMax": {
              "type": "number",
              "minimum": 15,
              "maximum": 45,
              "default": 27,
              "description": "Top of the recommended server inlet range, °C"
            },
            "allowableMax": {
              "type": "number",
              "minimum": 15,
              "maximum": 50,
              "default": 32,
              "description": "Top of the allowable server inlet range, °C"
            },
            "shutdownTemp": {
              "type": "number",
              "minimum": 15,
              "maximum": 60,
              "default": 35,
              "description": "Servers shut down above this inlet temperature, °C"
            },
            "warmingRate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30,
              "default": 2,
              "description": "Cold aisle warming with no cooling at full load, °C per minute"
            },
            "chwRate": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30,
              "default": 1,
              "description": "Chilled water warming with no chiller at full load, °C per minute"
            },
            "shutdownLoad": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 30,
              "description": "IT load left after the thermal shutdown, %"
            },
            "trains": {
              "type": "number",
              "minimum": 1,
              "maximum": 60,
              "default": 6,
              "description": "Trains in service on the section"
            },
            "lineVoltage": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000,
              "default": 750,
              "description": "Line voltage with no load, V DC"
            },
            "trainCurrent": {
              "type": "number",
              "minimum": 10,
              "maximum": 5000,
              "default": 400,
              "description": "Average current each moving train draws, A"
            },
            "overcurrent": {
              "type": "number",
              "minimum": 100,
              "maximum": 60000,
              "default": 5000,
              "description": "Default feeder overcurrent trip setting, A"
            },
            "etsTrip": {
              "type": "number",
              "minimum": 100,
              "maximum": 60000,
              "default": 9000,
              "description": "Default emergency trip system backup trip, A"
            },
            "faultCurrent": {
              "type": "number",
              "minimum": 100,
              "maximum": 100000,
              "default": 12000,
              "description": "Current of a short circuit on the line, A"
            },
            "tunnelShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 67,
              "description": "Share of the trains that are in the tunnel at any time, %"
            },
            "ambient": {
              "type": "number",
              "minimum": -20,
              "maximum": 45,
              "default": 26,
              "description": "Tunnel temperature with no trains, °C"
            },
            "fanStart": {
              "type": "number",
              "minimum": 10,
              "maximum": 50,
              "default": 30,
              "description": "Default tunnel temperature at which the first fan starts, °C"
            },
            "hotAlarm": {
              "type": "number",
              "minimum": 10,
              "maximum": 60,
              "default": 35,
              "description": "Tunnel temperature high alarm, °C"
            },
            "heatStress": {
              "type": "number",
              "minimum": 10,
              "maximum": 70,
              "default": 40,
              "description": "Tunnel temperature at which passengers in a stranded train are at risk, °C"
            },
            "possessionTime": {
              "type": "number",
              "minimum": 60,
              "maximum": 36000,
              "default": 1800,
              "description": "How long a work crew stays on the track once a possession starts, s"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "remove": {
            "type": "boolean",
            "description": "Remove this host from the site being extended"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "What the host does. Labs find hosts by role (plc, sis, hmi, ews, historian, report-server, jump, office, vendor)."
          },
          "ip": {
            "type": "string",
            "format": "ipv4"
          },
          "level": {
            "enum": [
              5,
              4,
              3.5,
              3,
              2,
              1,
              0
            ],
            "description": "Purdue level. 3.5 is the DMZ."
          },
          "kind": {
            "enum": [
              "external",
              "it",
              "dmz",
              "ot"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "enum": [
                "ssh",
                "http",
                "https",
                "modbus",
                "rdp"
              ]
            }
          },
          "os": {
            "type": "string"
          },
          "user": {
            "type": "string",
            "description": "The account you get with ssh"
          },
          "description": {
            "type": "string"
          },
          "mfa": {
            "type": "boolean",
            "description": "Multi-factor authentication for remote logins (jump hosts)"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "description": "The zones as found. A zone you list replaces the zone of that name.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "remove": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "sl": {
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "Target security level (SL-T)"
          },
          "vlan": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4042,
            "description": "The VLAN that carries the zone on the plant switches. Picked for you when left out."
          },
          "port": {
            "type": "string",
            "description": "A firewall port that carries the zone instead of a VLAN, for example wan1 for an outside link"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,23}$"
            }
          }
        }
      }
    },
    "conduits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "remove": {
            "type": "boolean"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,23}$"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "allow|deny from SRC to DST SERVICE [fc LIST]"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "description": "The firewall and switches that carry the zones. Hosts left off every switch go on the first one.",
      "additionalProperties": false,
      "properties": {
        "firewall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,23}$"
            },
            "vendor": {
              "enum": [
                "fortinet"
              ]
            },
            "model": {
              "type": "string"
            },
            "firmware": {
              "type": "string"
            },
            "hostname": {
              "type": "string"
            },
            "ip": {
              "type": "string",
              "description": "Management address"
            },
            "otSignatures": {
              "type": "boolean",
              "description": "OT application signatures loaded, so the firewall can filter Modbus function codes. Default true."
            }
          }
        },
        "switches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,23}$"
              },
              "vendor": {
                "enum": [
                  "hirschmann",
                  "cisco"
                ]
              },
              "model": {
                "type": "string"
              },
              "firmware": {
                "type": "string"
              },
              "hostname": {
                "type": "string"
              },
              "ip": {
                "type": "string",
                "description": "Management address"
              },
              "ports": {
                "type": "object",
                "description": "Port to host, for example \"1/3\": hmi-01 (Hirschmann) or Gi1/3: hmi-01 (Cisco). Leave the host empty for a spare port.",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,23}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "devices": {
      "type": "object",
      "description": "Modbus controllers, by host name. A points table you give replaces the inherited one.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "remove": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "description": "Firmware revision, returned by function code 43"
          },
          "points": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coil": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "addr",
                    "signal"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "addr": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535,
                      "description": "Modbus address, starting at 0"
                    },
                    "tag": {
                      "type": "string",
                      "description": "Tag name, as in the PLC program"
                    },
                    "signal": {
                      "enum": [
                        "pump.command",
                        "dosing.enable",
                        "control.auto",
                        "sis.bypass",
                        "setpoint.start",
                        "setpoint.stop",
                        "setpoint.chlorine",
                        "sis.trip_level",
                        "pump.running",
                        "dosing.running",
                        "alarm.high",
                        "alarm.low",
                        "alarm.overflow",
                        "sis.tripped",
                        "sis.bypassed",
                        "level",
                        "chlorine",
                        "sis.level",
                        "compressor.run",
                        "antisurge.auto",
                        "setpoint.discharge",
                        "setpoint.speed",
                        "setpoint.recycle",
                        "sis.trip_pressure",
                        "meter.factor",
                        "compressor.running",
                        "alarm.surge",
                        "alarm.high_pressure",
                        "alarm.venting",
                        "valve.esd_closed",
                        "pressure.suction",
                        "pressure.discharge",
                        "speed",
                        "recycle",
                        "flow",
                        "surge.margin",
                        "sis.pressure",
                        "meter.flow",
                        "chiller1.enable",
                        "chiller2.enable",
                        "pump.run",
                        "fire.isolate",
                        "fire.release",
                        "setpoint.chw",
                        "setpoint.supply_air",
                        "chiller1.running",
                        "chiller2.running",
                        "alarm.high_temp",
                        "alarm.critical_temp",
                        "fire.isolated",
                        "fire.alarm",
                        "fire.discharged",
                        "temp.chw_supply",
                        "temp.cold_aisle",
                        "load.it",
                        "power.cooling",
                        "pue",
                        "fire.temp",
                        "feeder.command",
                        "rectifier.enable",
                        "possession",
                        "setpoint.overcurrent",
                        "fan1.run",
                        "fan2.run",
                        "vent.auto",
                        "fire.mode",
                        "setpoint.fan_start",
                        "sis.trip_current",
                        "feeder.closed",
                        "rectifier.running",
                        "alarm.trip",
                        "voltage.line",
                        "current.feeder",
                        "trains.moving",
                        "trains.stranded",
                        "fan1.running",
                        "fan2.running",
                        "alarm.tunnel_hot",
                        "fire.mode_active",
                        "temp.tunnel",
                        "crew.on_track",
                        "sis.current"
                      ],
                      "description": "The process signal this point exposes"
                    },
                    "description": {
                      "type": "string"
                    },
                    "units": {
                      "type": "string",
                      "description": "How to scale the raw value"
                    }
                  }
                }
              },
              "di": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "addr",
                    "signal"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "addr": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535,
                      "description": "Modbus address, starting at 0"
                    },
                    "tag": {
                      "type": "string",
                      "description": "Tag name, as in the PLC program"
                    },
                    "signal": {
                      "enum": [
                        "pump.command",
                        "dosing.enable",
                        "control.auto",
                        "sis.bypass",
                        "setpoint.start",
                        "setpoint.stop",
                        "setpoint.chlorine",
                        "sis.trip_level",
                        "pump.running",
                        "dosing.running",
                        "alarm.high",
                        "alarm.low",
                        "alarm.overflow",
                        "sis.tripped",
                        "sis.bypassed",
                        "level",
                        "chlorine",
